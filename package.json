{
  "name": "quizzy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:backend": "npm --prefix backend test",
    "check:backend": "npm --prefix backend run check",
    "validate": "npm run lint && npm run build && npm run test:backend && npm run test:workers && npm run check:backend",
    "test:workers": "npm --prefix workers test",
    "validate:infra": "npm --prefix backend run sam:validate && npm --prefix backend run sam:build",
    "validate:all": "npm run validate && npm run validate:infra"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
